{
  "name": "artha",
  "private": true,
  "type": "module",
  "description": "Artha: Indian voice notes into the right actions, using personal context. Bas ishaara kaafi hai.",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "api": "tsx server/index.ts",
    "web": "vite",
    "build": "vite build && node scripts/build-lambda.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "clips": "tsx scripts/make-clips.ts",
    "eval": "tsx scripts/eval.ts",
    "typecheck": "tsc --noEmit",
    "demo-user": "tsx scripts/demo-user.ts",
    "start": "tsx server/index.ts",
    "deploy:web": "VITE_API_BASE=${ARTHA_API_URL:-https://artha-api.onrender.com} vite build && npx -y firebase-tools@latest deploy --only hosting --project artha-ai-app"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "puppeteer-core": "^23.10.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=24"
  }
}
