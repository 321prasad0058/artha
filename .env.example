# Artha AI environment. Copy to .env and fill in. Only OPENAI_API_KEY is required.

# Required: OpenAI key with access to gpt-transcribe, gpt-6-luna, gpt-4o-mini-tts and text-embedding-3-large
OPENAI_API_KEY=

# Recommended: any random string. Encrypts Gmail tokens and makes user ids.
ARTHA_TOKEN_KEY=change-me

# Optional: server port (default 8787)
PORT=8787

# Optional: real Google sign-in and Gmail (read-only). Not needed: `npm run demo-user` builds the Gmail user offline.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public base URL for the Google OAuth callback (<ARTHA_PUBLIC_URL>/api/gmail/callback). Leave empty on localhost.
ARTHA_PUBLIC_URL=

# Optional: send every WhatsApp/SMS/call link to one real number (the sample people have no real numbers). Digits only, with country code.
DEMO_PHONE=

# AWS only: S3 bucket for user memory. Leave EMPTY locally; data is then stored under data/.
ARTHA_BUCKET=

# Optional model overrides (defaults shown)
# ARTHA_STT_MODEL=gpt-transcribe
# ARTHA_PLAN_MODEL=gpt-6-luna
# ARTHA_PLAN_EFFORT=none
